{
  "name": "siklab-2026-tally",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:load": "node scripts/load-audit.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx --test tests/workflow.test.ts",
    "db:cloud:migrate": "node --env-file=.env.cloud.local --import tsx scripts/migrate.ts",
    "setup:cloud": "npm run db:cloud:migrate && node --env-file=.env.cloud.local --import tsx scripts/configure-cloud.ts",
    "deploy:production": "node scripts/deploy-production.mjs",
    "verify:hosted": "node --env-file=.env.cloud.local scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "2.119.2",
    "@vercel/functions": "3.11.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^15.2.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
