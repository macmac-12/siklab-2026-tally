# npm run setup:local generates .env.local with random credentials.
# For a separately provisioned PostgreSQL database:
DATABASE_URL=postgresql://siklab:CHANGE_ME@127.0.0.1:5433/siklab
DATABASE_PASSWORD=CHANGE_ME
SUPERADMIN_EMAIL=admin@siklab.test
SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
# Optional one-time import of the empty legacy installation's accounts.
# DATA_ROOT=/absolute/path/to/data/local

# Later HTTPS deployment: set the canonical browser origin and secure cookies.
# APP_ORIGIN=https://your-event-domain.example
# COOKIE_SECURE=true

# Supabase/Vercel production (set only as production secrets):
# DATABASE_URL=postgresql://siklab_app.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=1
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PROJECT_REF=PROJECT_REF
# SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
# BACKUP_STORAGE_BUCKET=siklab-private-backups
# CRON_SECRET=RANDOM_32_BYTE_SECRET
# Administrative setup only; never put this or bootstrap credentials in Vercel:
# ADMIN_DATABASE_URL=postgresql://MIGRATOR.PROJECT_REF:PASSWORD@POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-ca.crt
# SUPERADMIN_MUST_RESET=true
