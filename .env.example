# npm run setup:local generates .env.local with random credentials.
# For a separately provisioned PostgreSQL database:
DATABASE_URL=postgresql://siklab:CHANGE_ME@127.0.0.1:5433/siklab
DATABASE_PASSWORD=CHANGE_ME
SUPERADMIN_EMAIL=admin@siklab.test
SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
# Optional one-time import of the empty legacy installation's accounts.
# DATA_ROOT=/absolute/path/to/data/local
